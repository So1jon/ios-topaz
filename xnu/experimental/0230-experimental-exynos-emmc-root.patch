diff --git a/bsd/dev/sweet_dwmmc.h b/bsd/dev/sweet_dwmmc.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_dwmmc.h
@@ -0,0 +1,58 @@
+#pragma once
+/*
+ * Read-only polled driver for the Synopsys DesignWare Mobile Storage host (DW-MSHC) that Exynos 7870
+ * uses for eMMC (mmc0 @ 0x13540000 in mainline Linux). It TAKES OVER the state the bootloader left
+ * (clocks, bus width, timing, card selected): it never touches clocks, pinmux, power or the card
+ * configuration, and it never writes to the card. PIO through the FIFO, no DMA/IDMAC, so the
+ * Exynos "SMU" address translation does not matter.
+ *
+ * Untested on hardware: first use is shim/exynos/probe_main.c (prints, writes nothing to storage).
+ */
+#include <stdint.h>
+
+#define DWMMC_ETIMEOUT	(-1)	/* no response / controller stuck */
+#define DWMMC_ECMD	(-2)	/* response error or CRC error */
+#define DWMMC_EDATA	(-3)	/* data timeout, CRC, start/end bit or short transfer */
+#define DWMMC_EARG	(-4)
+
+struct dwmmc {
+	uintptr_t base;
+	uint32_t data_off;	/* FIFO port offset: 0x100 before VERID 0x240a, 0x200 from then on */
+	uint32_t rca;		/* relative card address; the bootloader normally leaves 1 */
+	uint32_t hold;		/* extra CMD flag: USE_HOLD_REG (needed in high-speed timings) */
+	uint32_t rintsts;	/* RINTSTS seen at the end of the last command / transfer */
+};
+
+/* Reads VERID, picks the FIFO port offset. No writes. */
+int dwmmc_init(struct dwmmc *h, uintptr_t base);
+/* CMD13: raw card status (R1). State is bits [12:9]: 3 = stby, 4 = tran. */
+int dwmmc_card_status(struct dwmmc *h, uint32_t *status);
+/* CMD7 with the RCA: select the card (stby -> tran). */
+int dwmmc_select(struct dwmmc *h);
+/* Read nsect 512-byte sectors starting at lba (high-capacity addressing). */
+int dwmmc_read(struct dwmmc *h, uint64_t lba, uint32_t nsect, void *buf);
+
+/* register offsets, for diagnostics */
+#define DW_CTRL		0x00
+#define DW_PWREN	0x04
+#define DW_CLKDIV	0x08
+#define DW_CLKSRC	0x0c
+#define DW_CLKENA	0x10
+#define DW_TMOUT	0x14
+#define DW_CTYPE	0x18
+#define DW_BLKSIZ	0x1c
+#define DW_BYTCNT	0x20
+#define DW_INTMASK	0x24
+#define DW_CMDARG	0x28
+#define DW_CMD		0x2c
+#define DW_RESP0	0x30
+#define DW_RINTSTS	0x44
+#define DW_STATUS	0x48
+#define DW_FIFOTH	0x4c
+#define DW_CDETECT	0x50
+#define DW_VERID	0x6c
+#define DW_HCON		0x70
+#define DW_UHS		0x74
+#define DW_BMOD		0x80
+
+uint32_t dwmmc_reg(struct dwmmc *h, uint32_t off);
diff --git a/bsd/dev/sweet_dwmmc.c b/bsd/dev/sweet_dwmmc.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_dwmmc.c
@@ -0,0 +1,189 @@
+/*
+ * Read-only polled DW-MSHC driver, see dwmmc.h. Register layout: Synopsys DWC_mobile_storage databook
+ * as implemented by Linux drivers/mmc/host/dw_mmc.c.
+ */
+#include "sweet_dwmmc.h"
+
+#ifdef DWMMC_SIM
+extern uint32_t sim_rd(uintptr_t addr);
+extern void sim_wr(uintptr_t addr, uint32_t v);
+#define RD(h, off)	sim_rd((h)->base + (off))
+#define WR(h, off, v)	sim_wr((h)->base + (off), (v))
+#else
+#define RD(h, off)	(*(volatile uint32_t *)((h)->base + (off)))
+#define WR(h, off, v)	(*(volatile uint32_t *)((h)->base + (off)) = (v))
+#endif
+
+/* CTRL */
+#define CTRL_FIFO_RESET		(1u << 1)
+#define CTRL_DMA_RESET		(1u << 2)
+#define CTRL_INT_ENABLE		(1u << 4)
+#define CTRL_DMA_ENABLE		(1u << 5)
+#define CTRL_USE_IDMAC		(1u << 25)
+/* CMD */
+#define CMD_START		(1u << 31)
+#define CMD_USE_HOLD_REG	(1u << 29)
+#define CMD_WAIT_PRVDATA	(1u << 13)
+#define CMD_SEND_AUTO_STOP	(1u << 12)
+#define CMD_DATA_EXPECT		(1u << 9)
+#define CMD_CHECK_RESP_CRC	(1u << 8)
+#define CMD_RESP_EXPECT		(1u << 6)
+/* RINTSTS */
+#define INT_CD			(1u << 0)
+#define INT_RE			(1u << 1)
+#define INT_DTO			(1u << 3)
+#define INT_RXDR		(1u << 5)
+#define INT_RCRC		(1u << 6)
+#define INT_DCRC		(1u << 7)
+#define INT_RTO			(1u << 8)
+#define INT_DRTO		(1u << 9)
+#define INT_HLE			(1u << 12)
+#define INT_SBE			(1u << 13)
+#define INT_EBE			(1u << 15)
+/* STATUS */
+#define ST_DATA_BUSY		(1u << 9)
+
+#define SPIN_CMD		2000000u
+#define SPIN_DATA		60000000u
+
+uint32_t dwmmc_reg(struct dwmmc *h, uint32_t off)
+{
+	return RD(h, off);
+}
+
+int dwmmc_init(struct dwmmc *h, uintptr_t base)
+{
+	h->base = base;
+	uint32_t ver = RD(h, DW_VERID);
+	h->data_off = (ver & 0xffff) >= 0x240a ? 0x200 : 0x100;
+	h->rca = 1;
+	h->hold = 0;
+	h->rintsts = 0;
+	return 0;
+}
+
+static int wait_idle(struct dwmmc *h)
+{
+	for (uint32_t i = 0; i < SPIN_CMD; i++)
+		if (!(RD(h, DW_STATUS) & ST_DATA_BUSY))
+			return 0;
+	return DWMMC_ETIMEOUT;
+}
+
+/* PIO only: no IDMAC, no DMA interface, no interrupts, FIFO empty. Touches nothing else. */
+static void prepare_pio(struct dwmmc *h)
+{
+	uint32_t ctrl = RD(h, DW_CTRL);
+	ctrl &= ~(CTRL_USE_IDMAC | CTRL_DMA_ENABLE | CTRL_INT_ENABLE);
+	WR(h, DW_CTRL, ctrl | CTRL_FIFO_RESET | CTRL_DMA_RESET);
+	for (uint32_t i = 0; i < SPIN_CMD; i++)
+		if (!(RD(h, DW_CTRL) & (CTRL_FIFO_RESET | CTRL_DMA_RESET)))
+			break;
+	WR(h, DW_INTMASK, 0);
+	WR(h, DW_RINTSTS, 0xffffffffu);
+}
+
+/* Issue one command and wait for it to be accepted and answered; RINTSTS is left for the caller. */
+static int send(struct dwmmc *h, uint32_t idx, uint32_t arg, uint32_t flags)
+{
+	int e = wait_idle(h);
+	if (e)
+		return e;
+	WR(h, DW_RINTSTS, 0xffffffffu);
+	WR(h, DW_CMDARG, arg);
+	WR(h, DW_CMD, CMD_START | (h->hold ? CMD_USE_HOLD_REG : 0) | flags | (idx & 0x3f));
+	uint32_t i;
+	for (i = 0; i < SPIN_CMD; i++)
+		if (!(RD(h, DW_CMD) & CMD_START))
+			break;
+	if (i == SPIN_CMD)
+		return DWMMC_ETIMEOUT;
+	for (i = 0; i < SPIN_CMD; i++) {
+		uint32_t r = RD(h, DW_RINTSTS);
+		if (r & INT_HLE)
+			return DWMMC_ECMD;
+		if (r & INT_CD) {
+			h->rintsts = r;
+			if (r & INT_RTO)
+				return DWMMC_ETIMEOUT;
+			if (r & (INT_RE | INT_RCRC))
+				return DWMMC_ECMD;
+			return 0;
+		}
+	}
+	return DWMMC_ETIMEOUT;
+}
+
+int dwmmc_card_status(struct dwmmc *h, uint32_t *status)
+{
+	prepare_pio(h);
+	int e = send(h, 13, h->rca << 16, CMD_RESP_EXPECT | CMD_CHECK_RESP_CRC);
+	if (e)
+		return e;
+	*status = RD(h, DW_RESP0);
+	return 0;
+}
+
+int dwmmc_select(struct dwmmc *h)
+{
+	prepare_pio(h);
+	return send(h, 7, h->rca << 16, CMD_RESP_EXPECT | CMD_CHECK_RESP_CRC);
+}
+
+static int fifo_count(struct dwmmc *h)
+{
+	return (int)((RD(h, DW_STATUS) >> 17) & 0x1fff);
+}
+
+/* One command with a read data phase of nsect sectors (nsect <= 255). */
+static int read_chunk(struct dwmmc *h, uint64_t lba, uint32_t nsect, uint32_t *p)
+{
+	uint32_t words = nsect * 128, got = 0;
+
+	prepare_pio(h);
+	WR(h, DW_BLKSIZ, 512);
+	WR(h, DW_BYTCNT, nsect * 512);
+	int e = send(h, nsect == 1 ? 17 : 18, (uint32_t)lba,
+	    CMD_RESP_EXPECT | CMD_CHECK_RESP_CRC | CMD_DATA_EXPECT | CMD_WAIT_PRVDATA |
+	    (nsect > 1 ? CMD_SEND_AUTO_STOP : 0));
+	if (e)
+		return e;
+	uint32_t r = h->rintsts;
+	for (uint32_t spin = 0; spin < SPIN_DATA; spin++) {
+		r |= RD(h, DW_RINTSTS);
+		if (r & (INT_DCRC | INT_DRTO | INT_SBE | INT_EBE))
+			return DWMMC_EDATA;
+		if (r & (INT_RXDR | INT_DTO)) {
+			int n = fifo_count(h);
+			while (n-- > 0 && got < words)
+				p[got++] = RD(h, h->data_off);
+			WR(h, DW_RINTSTS, INT_RXDR);
+			r &= ~INT_RXDR;
+			if (r & INT_DTO) {
+				/* transfer over: whatever is still in the FIFO is the tail */
+				for (int k = fifo_count(h); k > 0 && got < words; k--)
+					p[got++] = RD(h, h->data_off);
+				return got == words ? 0 : DWMMC_EDATA;
+			}
+		}
+	}
+	return DWMMC_ETIMEOUT;
+}
+
+int dwmmc_read(struct dwmmc *h, uint64_t lba, uint32_t nsect, void *buf)
+{
+	uint32_t *p = buf;
+
+	if (!buf || !nsect || lba > 0xffffffffull)
+		return DWMMC_EARG;
+	while (nsect) {
+		uint32_t n = nsect > 64 ? 64 : nsect;
+		int e = read_chunk(h, lba, n, p);
+		if (e)
+			return e;
+		lba += n;
+		nsect -= n;
+		p += n * 128;
+	}
+	return 0;
+}
diff --git a/bsd/dev/sweet_gpt.h b/bsd/dev/sweet_gpt.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_gpt.h
@@ -0,0 +1,15 @@
+#pragma once
+/*
+ * Find a GPT partition by name through the read-only DW-MSHC driver. Portable: used by the shim probe,
+ * the host simulator test and (embedded by tools/mk_emmc_patch.py) the xnu eMMC root device.
+ */
+#include <stdint.h>
+#include "sweet_dwmmc.h"
+
+#define GPT_ENOGPT	(-10)	/* LBA 1 has no "EFI PART" signature */
+#define GPT_EBAD	(-11)	/* header values outside what this reader accepts */
+#define GPT_ENOTFOUND	(-12)	/* no partition with that name */
+
+/* Name match is ASCII, case-insensitive. On success first/last are the partition's LBA range (inclusive).
+ * nparts (optional) receives the number of non-empty entries seen up to the match. */
+int gpt_find(struct dwmmc *h, const char *name, uint64_t *first, uint64_t *last, uint32_t *nparts);
diff --git a/bsd/dev/sweet_gpt.c b/bsd/dev/sweet_gpt.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_gpt.c
@@ -0,0 +1,77 @@
+/* GPT partition lookup by name, see gpt.h. 512-byte logical sectors, 128-byte entries. */
+#include "sweet_gpt.h"
+
+static uint32_t le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint64_t le64(const uint8_t *p)
+{
+	return (uint64_t)le32(p) | (uint64_t)le32(p + 4) << 32;
+}
+
+static char fold(char c)
+{
+	return (c >= 'A' && c <= 'Z') ? (char)(c + 32) : c;
+}
+
+/* entry name is UTF-16LE at +56 (36 code units); compare its ASCII range with `want` */
+static int name_is(const uint8_t *e, const char *want)
+{
+	for (int i = 0; i < 36; i++) {
+		char a = (e[56 + i * 2 + 1] == 0) ? (char)e[56 + i * 2] : '?';
+		char w = want[i];
+		if (fold(a) != fold(w))
+			return 0;
+		if (!w)
+			return 1;
+	}
+	return want[36] == 0;
+}
+
+int gpt_find(struct dwmmc *h, const char *name, uint64_t *first, uint64_t *last, uint32_t *nparts)
+{
+	uint32_t sec[128];		/* 512 bytes, 4-byte aligned for the FIFO reads */
+	uint32_t buf[4 * 128];		/* 16 entries per read */
+	const uint8_t *s = (const uint8_t *)sec;
+	const uint8_t *b = (const uint8_t *)buf;
+	static const char sig[8] = { 'E', 'F', 'I', ' ', 'P', 'A', 'R', 'T' };
+	uint32_t used = 0;
+	int rc = dwmmc_read(h, 1, 1, sec);
+
+	if (rc)
+		return rc;
+	for (int i = 0; i < 8; i++)
+		if ((char)s[i] != sig[i])
+			return GPT_ENOGPT;
+	uint32_t nent = le32(s + 80), esz = le32(s + 84);
+	uint64_t elba = le64(s + 72);
+	if (esz != 128 || nent == 0 || nent > 1024 || elba < 2 || elba > 0xffff0000ull)
+		return GPT_EBAD;
+	for (uint32_t i = 0; i < nent; i += 16) {
+		rc = dwmmc_read(h, elba + i / 4, 4, buf);
+		if (rc)
+			return rc;
+		for (uint32_t j = 0; j < 16 && i + j < nent; j++) {
+			const uint8_t *e = b + j * 128;
+			int empty = 1;
+			for (int k = 0; k < 16; k++)
+				if (e[k])
+					empty = 0;
+			if (empty)
+				continue;
+			used++;
+			if (name_is(e, name)) {
+				*first = le64(e + 32);
+				*last = le64(e + 40);
+				if (nparts)
+					*nparts = used;
+				return (*first <= *last) ? 0 : GPT_EBAD;
+			}
+		}
+	}
+	if (nparts)
+		*nparts = used;
+	return GPT_ENOTFOUND;
+}
diff --git a/bsd/dev/sweet_cowovl.h b/bsd/dev/sweet_cowovl.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_cowovl.h
@@ -0,0 +1,44 @@
+/*
+ * RAM copy-on-write overlay for a read-only block device (used by xnu_sweet_emmc.c).
+ *
+ * iOS wants a writable root (launchd runs `mount -uw /`, HFS replays its journal), but the eMMC driver must
+ * never write the phone's flash. Writes land in 4 KiB chunks kept in RAM; reads take the chunk from RAM when
+ * it was written and from the card otherwise. Nothing survives a reboot, by design.
+ *
+ * Portable (no kernel headers): the allocator and the "read the original chunk" function are supplied by
+ * the caller, so the same code is unit-tested on the host (cowovl_test.c).
+ */
+#ifndef COWOVL_H
+#define COWOVL_H
+#include <stdint.h>
+#include <stddef.h>
+
+#define COWOVL_CHUNK 4096u
+
+struct cowovl_ent {
+	uint64_t chunk;			/* chunk index + 1; 0 = free slot */
+	uint8_t *page;
+};
+
+struct cowovl {
+	struct cowovl_ent *tab;
+	uint32_t cap;			/* power of two, >= 2 * max */
+	uint32_t used, max;		/* chunks in use / allowed */
+	void *(*alloc)(size_t);		/* zeroed memory or NULL */
+	void (*release)(void *, size_t);
+};
+
+#define COWOVL_ENOMEM (-1)
+#define COWOVL_EFULL  (-2)
+#define COWOVL_EREAD  (-3)
+
+int cowovl_init(struct cowovl *o, uint32_t max_chunks, void *(*alloc)(size_t), void (*release)(void *, size_t));
+
+/* overwrite the parts of buf (= device bytes [off, off+len)) that were written before */
+void cowovl_patch(const struct cowovl *o, uint64_t off, uint32_t len, uint8_t *buf);
+
+/* base_read(ctx, chunk, page): fetch the original 4 KiB chunk (zero-fill past the end of the device); 0 = ok */
+typedef int (*cowovl_base_read)(void *ctx, uint64_t chunk, uint8_t *page);
+int cowovl_write(struct cowovl *o, uint64_t off, uint32_t len, const uint8_t *src, cowovl_base_read base_read,
+    void *ctx);
+#endif
diff --git a/bsd/dev/sweet_cowovl.c b/bsd/dev/sweet_cowovl.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_cowovl.c
@@ -0,0 +1,80 @@
+/* RAM copy-on-write overlay, see cowovl.h. Open addressing, linear probing, never deletes. */
+#include "sweet_cowovl.h"
+#include <string.h>
+
+static uint32_t slot_of(const struct cowovl *o, uint64_t chunk)
+{
+	uint64_t h = chunk * 0x9E3779B97F4A7C15ull;
+	return (uint32_t)(h >> 32) & (o->cap - 1);
+}
+
+static struct cowovl_ent *find(const struct cowovl *o, uint64_t chunk)
+{
+	for (uint32_t i = slot_of(o, chunk), n = 0; n < o->cap; i = (i + 1) & (o->cap - 1), n++) {
+		if (o->tab[i].chunk == chunk + 1)
+			return &o->tab[i];
+		if (o->tab[i].chunk == 0)
+			return NULL;
+	}
+	return NULL;
+}
+
+int cowovl_init(struct cowovl *o, uint32_t max_chunks, void *(*alloc)(size_t), void (*release)(void *, size_t))
+{
+	uint32_t cap = 16;
+	while (cap < 2 * max_chunks)
+		cap <<= 1;
+	memset(o, 0, sizeof(*o));
+	o->alloc = alloc;
+	o->release = release;
+	o->tab = alloc((size_t)cap * sizeof(struct cowovl_ent));
+	if (!o->tab)
+		return COWOVL_ENOMEM;
+	o->cap = cap;
+	o->max = max_chunks;
+	return 0;
+}
+
+void cowovl_patch(const struct cowovl *o, uint64_t off, uint32_t len, uint8_t *buf)
+{
+	if (!o->tab || !o->used)
+		return;
+	for (uint64_t c = off / COWOVL_CHUNK; c * COWOVL_CHUNK < off + len; c++) {
+		const struct cowovl_ent *e = find(o, c);
+		if (!e)
+			continue;
+		uint64_t lo = c * COWOVL_CHUNK > off ? c * COWOVL_CHUNK : off;
+		uint64_t hi = (c + 1) * COWOVL_CHUNK < off + len ? (c + 1) * COWOVL_CHUNK : off + len;
+		memcpy(buf + (lo - off), e->page + (lo - c * COWOVL_CHUNK), (size_t)(hi - lo));
+	}
+}
+
+int cowovl_write(struct cowovl *o, uint64_t off, uint32_t len, const uint8_t *src, cowovl_base_read base_read,
+    void *ctx)
+{
+	for (uint64_t c = off / COWOVL_CHUNK; c * COWOVL_CHUNK < off + len; c++) {
+		uint64_t lo = c * COWOVL_CHUNK > off ? c * COWOVL_CHUNK : off;
+		uint64_t hi = (c + 1) * COWOVL_CHUNK < off + len ? (c + 1) * COWOVL_CHUNK : off + len;
+		struct cowovl_ent *e = find(o, c);
+		if (!e) {
+			if (o->used >= o->max)
+				return COWOVL_EFULL;
+			uint8_t *page = o->alloc(COWOVL_CHUNK);
+			if (!page)
+				return COWOVL_ENOMEM;
+			if (hi - lo != COWOVL_CHUNK && base_read(ctx, c, page)) {
+				o->release(page, COWOVL_CHUNK);
+				return COWOVL_EREAD;
+			}
+			uint32_t i = slot_of(o, c);
+			while (o->tab[i].chunk)
+				i = (i + 1) & (o->cap - 1);
+			o->tab[i].chunk = c + 1;
+			o->tab[i].page = page;
+			o->used++;
+			e = &o->tab[i];
+		}
+		memcpy(e->page + (lo - c * COWOVL_CHUNK), src + (lo - off), (size_t)(hi - lo));
+	}
+	return 0;
+}
