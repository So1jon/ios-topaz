diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -35,7 +35,10 @@
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
 /* topaz: Cortex-A53/A73 have no PAN (ARMv8.1); MSR PAN is undefined there */
-#define __ARM_16K_PG__            1
+/* EXPERIMENT (page_size=4k): 4K translation granule so Cortex-A53-only SoCs
+ * (Exynos 7870, ...) can run xnu. Leaving __ARM_16K_PG__ undefined selects
+ * ARM_PGSHIFT 12, like xnu's own BCM2837 (Raspberry Pi 3) config. */
+/* #define __ARM_16K_PG__ 1 */
 
 #define HAS_GIC_V3                1
 
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -10985,7 +10985,9 @@
  * Ensure that 64-bit devices using 4K pages can nest the commpage completely
  * above the maximum userspace VA.
  */
+#if !defined(XNU_PLATFORM_MacOSX) && !defined(XNU_PLATFORM_DriverKit)
 static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) >= MACH_VM_MAX_ADDRESS);
+#endif /* EXPERIMENT 4k: like 16K on macOS, the VM reserves the commpage region */
 #else
 #error Nested shared page mapping is unsupported on this config
 #endif
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -333,7 +333,9 @@
 ARM64_LINK_ADDR    =0xfffffff007004000
 
 # Use ARM_LARGE_MEMORY config for all MacOSX targets.
-ifneq ($(filter $(PLATFORM),MacOSX),)
+# EXPERIMENT 4k: the large-memory layout (41-bit kernel VA, T1SZ 17) needs 16K
+# pages; 4K uses T1SZ 25, so keep the 37-bit layout at 0xfffffff007004000.
+ifneq ($(filter $(PLATFORM),MacOSX-large-memory-disabled-for-4k),)
 LARGE_MEMORY_DEFINE=-DARM_LARGE_MEMORY=1
 ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
