diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -35,7 +35,10 @@
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
 /* topaz: Cortex-A53/A73 have no PAN (ARMv8.1); MSR PAN is undefined there */
-#define __ARM_16K_PG__            1
+/* EXPERIMENT (page_size=4k): 4K translation granule so Cortex-A53-only SoCs
+ * (Exynos 7870, ...) can run xnu. Leaving __ARM_16K_PG__ undefined selects
+ * ARM_PGSHIFT 12, like xnu's own BCM2837 (Raspberry Pi 3) config. */
+/* #define __ARM_16K_PG__ 1 */
 
 #define HAS_GIC_V3                1
 
diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -10985,7 +10985,9 @@
  * Ensure that 64-bit devices using 4K pages can nest the commpage completely
  * above the maximum userspace VA.
  */
+#if !defined(XNU_PLATFORM_MacOSX) && !defined(XNU_PLATFORM_DriverKit)
 static_assert((_COMM_PAGE64_BASE_ADDRESS & ~ARM_TT_L1_OFFMASK) >= MACH_VM_MAX_ADDRESS);
+#endif /* EXPERIMENT 4k: like 16K on macOS, the VM reserves the commpage region */
 #else
 #error Nested shared page mapping is unsupported on this config
 #endif
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -333,7 +333,9 @@
 ARM64_LINK_ADDR    =0xfffffff007004000
 
 # Use ARM_LARGE_MEMORY config for all MacOSX targets.
-ifneq ($(filter $(PLATFORM),MacOSX),)
+# EXPERIMENT 4k: the large-memory layout (41-bit kernel VA, T1SZ 17) needs 16K
+# pages; 4K uses T1SZ 25, so keep the 37-bit layout at 0xfffffff007004000.
+ifneq ($(filter $(PLATFORM),MacOSX-large-memory-disabled-for-4k),)
 LARGE_MEMORY_DEFINE=-DARM_LARGE_MEMORY=1
 ARM64_PLKSEG_ADDR  =0xfffffe0004004000
 ARM64_LINK_ADDR    =0xfffffe0007004000
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -680,19 +680,29 @@
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
-	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
-	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * EXPERIMENT 4k: splash framebuffer as 2MB Normal-NC blocks. The L2 table
+	 * is found through the V=P L1 entry (x1) of the framebuffer's 1GB region
+	 * (RAM shares it), not by its position in bootstrap_pagetables; 8 blocks
+	 * (16MB) cover the 1080x2400x4 framebuffer.
 	 */
 	MOV64	x10, 0x9c000000
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
+	and		x13, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x13, x13, #(ARM_TT_L1_SHIFT)
+	add		x13, x1, x13, lsl #(TTE_SHIFT)
+	ldr		x13, [x13]
+	and		x13, x13, #(ARM_TTE_TABLE_MASK)
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
-	add		x13, x25, #(2 * PGBYTES)
-	str		x11, [x13, x12, lsl #TTE_SHIFT]
+	add		x13, x13, x12, lsl #(TTE_SHIFT)
+	MOV64	x9, (1 << ARM_TT_L2_SHIFT)
+	mov		x12, #8
+Lsweet_fb_map:
+	str		x11, [x13], #8
+	add		x11, x11, x9
+	subs	x12, x12, #1
+	b.ne	Lsweet_fb_map
 #endif
 
 	/* Ensure TTEs are visible */
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1837,16 +1837,20 @@
 sweet_early_map_final(void)
 {
 	const vm_map_address_t va = SWEET_EARLY_FB_VA;
-	assert(va + ARM_TT_L2_SIZE <= gVirtBase);
+	assert(va + 8 * ARM_TT_L2_SIZE <= gVirtBase);
+	/* EXPERIMENT 4k: the L2 table of this 1GB region may not exist yet */
+	init_ptpages(cpu_tte, va, va + 8 * ARM_TT_L2_SIZE, TRUE, ARM_TTE_TABLE_AP(ARM_TTE_TABLE_AP_USER_NA));
 	tt_entry_t l1 = cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
 	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
-	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
-	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
-	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
-	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	for (unsigned i = 0; i < 8; i++) {
+		assert(slot[i] == ARM_TTE_EMPTY);
+		slot[i] = (0x9c000000ULL + ((uint64_t)i << ARM_TT_L2_SHIFT)) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
 	__asm__ volatile("dsb ishst" ::: "memory");
 }
 #endif
